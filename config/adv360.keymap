#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/stp.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/pointing.h>

/* Layer indices. Kinesis layer LED colors follow the index. */
#define BASE 0
#define NAV  1
#define SYM  2
#define APP  3
#define FN   4
#define MOD  5

#define ___ &trans
#define XXX &none

/* Rectangle window actions. Halves and center use Rectangle defaults (Ctrl+Opt).
 * Maximize and display moves use the Cmd+Opt chords set in Rectangle prefs. */
#define WIN_LEFT   &kp LC(LA(LEFT))
#define WIN_RIGHT  &kp LC(LA(RIGHT))
#define WIN_TOP    &kp LC(LA(UP))
#define WIN_BOTTOM &kp LC(LA(DOWN))
#define WIN_CENTER &kp LC(LA(C))
#define WIN_RESTORE &kp LC(LA(BSPC))
#define WIN_MAX    &kp LG(LA(RET))
#define WIN_PREV_DISPLAY &kp LG(LA(LEFT))
#define WIN_NEXT_DISPLAY &kp LG(LA(RIGHT))

/* Row layout per layer (key positions):
 *   0-6           | 7-13
 *   14-20         | 21-27
 *   28-34  35 36 37 38  39-45
 *   46-51  52 53        54-59
 *   60-64  65 66 67 68 69 70  71-75
 */

/ {
    behaviors {
      #include "macros.dtsi"
      #include "version.dtsi"
      #include "symbols.dtsi"

      /* Thumb layer keys: tap = key, hold = layer. Balanced so that
       * pressing and releasing another key during the hold picks the layer. */
      lth: layer_tap_hold {
          compatible = "zmk,behavior-hold-tap";
          #binding-cells = <2>;
          tapping-term-ms = <200>;
          quick-tap-ms = <175>;
          flavor = "balanced";
          bindings = <&mo>, <&kp>;
      };
    };

  keymap {
    compatible = "zmk,keymap";

    default_layer {
      display-name = "Base";
      bindings = <
        &kp EQUAL &kp N1    &kp N2     &kp N3   &kp N4    &kp N5 &tog SYM                                                                 &mo MOD &kp N6 &kp N7 &kp N8    &kp N9   &kp N0   &kp MINUS
        &kp TAB   &kp Q     &kp W      &kp E    &kp R     &kp T  XXX                                                                      XXX     &kp Y  &kp U  &kp I     &kp O    &kp P    &kp BSLH
        &kp ESC   &kp A     &kp S      &kp D    &kp F     &kp G  XXX            &kp LALT &kp LGUI      &kp RGUI      &kp RALT              XXX     &kp H  &kp J  &kp K     &kp L    &kp SEMI &kp SQT
        &kp LSHFT &kp Z     &kp X      &kp C    &kp V     &kp B                          &kp LCTRL     &kp RCTRL                                   &kp N  &kp M  &kp COMMA &kp DOT  &kp FSLH &kp RSHFT
        &mo FN    &kp GRAVE &caps_word &kp LEFT &kp RIGHT               &kp BSPC &lth APP DEL &lth NAV ESC &lth SYM TAB &kp ENTER &kp SPACE               &kp UP &kp DOWN  &kp LBKT &kp RBKT &mo FN
      >;
    };

    nav {
      display-name = "Nav";
      bindings = <
        ___ ___           ___        ___         ___        ___              ___                                                          ___ ___              ___          ___        ___           ___           ___
        ___ &kp LG(GRAVE) WIN_TOP    WIN_RESTORE ___        &kp LC(UP)       XXX                                                          XXX &kp LG(LEFT)     &kp LA(LEFT) &kp PG_UP  &kp LA(RIGHT) &kp LG(RIGHT) &kp HOME
        ___ WIN_PREV_DISPLAY WIN_LEFT WIN_MAX    WIN_RIGHT  WIN_NEXT_DISPLAY XXX              ___ ___ ___ ___                             XXX &kp LEFT         &kp DOWN     &kp UP     &kp RIGHT     ___           &kp END
        ___ ___           WIN_BOTTOM WIN_CENTER  ___        ___                                   ___ ___                                     &kp LC(LS(TAB))  &kp LC(TAB)  &kp PG_DN  &kp LG(LBKT)  &kp LG(RBKT)  ___
        ___ ___           ___        ___         ___                              ___ ___ ___ ___ ___ ___                                                      ___          ___        ___           ___           ___
      >;
    };

    sym {
      display-name = "Sym";
      bindings = <
        ___       ___        ___        ___     ___        ___       ___                                                   ___ ___       ___    ___    ___    ___       ___
        ___       &mpar      &mbkt      &mbrc   &mtmpl     &kp GRAVE XXX                                                   XXX &kp MINUS &kp N7 &kp N8 &kp N9 &kp PLUS  &kp ASTRK
        &kp UNDER &fat_arrow &triple_eq &not_eq &opt_chain &nullish  XXX           ___ ___ ___ ___                         XXX &kp EQUAL &kp N4 &kp N5 &kp N6 &kp COLON &kp DQT
        ___       &and_and   &or_or     &kp LT  &kp GT     &kp TILDE                    ___ ___                                &kp FSLH  &kp N1 &kp N2 &kp N3 &kp PRCNT ___
        ___       ___        ___        ___     ___                       ___ ___ ___ ___ ___ &kp N0                                     &kp N0 &kp DOT ___   ___       ___
      >;
    };

    app {
      display-name = "App";
      bindings = <
        ___ &kp HYPER(N1) &kp HYPER(N2) &kp HYPER(N3)   &kp HYPER(N4)    &kp HYPER(N5) ___                                                                 ___ &kp HYPER(N6) &kp HYPER(N7) &kp HYPER(N8)    &kp HYPER(N9)   &kp HYPER(N0)   ___
        ___ &kp HYPER(Q)  &kp HYPER(W)  &kp HYPER(E)    &kp HYPER(R)     &kp HYPER(T)  XXX                                                                 XXX &kp HYPER(Y)  &kp HYPER(U)  &kp HYPER(I)     &kp HYPER(O)    &kp HYPER(P)    ___
        ___ &kp HYPER(A)  &kp HYPER(S)  &kp HYPER(D)    &kp HYPER(F)     &kp HYPER(G)  XXX            ___ ___ ___ ___                                      XXX &kp HYPER(H)  &kp HYPER(J)  &kp HYPER(K)     &kp HYPER(L)    &kp HYPER(SEMI) ___
        ___ &kp HYPER(Z)  &kp HYPER(X)  &kp HYPER(C)    &kp HYPER(V)     &kp HYPER(B)                      ___ ___                                             &kp HYPER(N)  &kp HYPER(M)  &kp HYPER(COMMA) &kp HYPER(DOT)  ___             ___
        ___ ___           ___           &kp HYPER(LEFT) &kp HYPER(RIGHT)                ___ ___ ___ ___ &kp HYPER(RET) &kp HYPER(SPACE)                        &kp HYPER(UP) &kp HYPER(DOWN) ___            ___             ___
      >;
    };

    fn {
      display-name = "Fn";
      bindings = <
        &kp F1 &kp F2       &kp F3       &kp F4 &kp F5 &kp F6 ___                                                   ___ &kp F7     &kp F8       &kp F9       &kp F10 &kp F11 &kp F12
        ___    &kp C_BRI_DN &kp C_BRI_UP ___    ___    ___    XXX                                                   XXX &kp C_PREV &kp C_PP     &kp C_NEXT   ___     ___     ___
        ___    ___          ___          ___    ___    ___    XXX           ___ ___ ___ ___                         XXX &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP ___     ___     ___
        ___    ___          ___          ___    ___    ___                        ___ ___                               ___        ___          ___          ___     ___     ___
        ___    ___          &kp CAPS     ___    ___                 ___ ___ ___ ___ ___ ___                                        ___          ___          ___     ___     ___
      >;
    };

    mod {
      display-name = "Mod";
      bindings = <
        &none &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none                                                                     &trans                 &none        &none        &none        &none &none &none
        &none &none        &none        &none        &none        &none        &bootloader                                                               &bootloader            &none        &none        &none        &none &none &none
        &studio_unlock &none        &none        &none        &none        &none        &none                   &none &none &bt BT_CLR &none                      &stp STP_BAT &none        &none        &none        &none &none &none
        &none &none        &none        &none        &macro_ver   &none                                      &none &none                                                        &none        &none        &none        &none &none &none
        &none &none        &none        &none        &none                                       &none &none &none &none      &bl BL_TOG &rgb_ug RGB_TOG                                     &bl BL_INC   &bl BL_DEC   &none &none &none
      >;
    };

    extra1 {
      display-name = "Red";
      status = "reserved";
    };

    extra2 {
      display-name = "Purple";
      status = "reserved";
    };

    extra3 {
      display-name = "Cyan";
      status = "reserved";
    };

    extra4 {
      display-name = "Yellow";
      status = "reserved";
    };
  };
};
